@startuml

' ==============================
' GameList - Casos de Uso
' Entrega 02
' ==============================

left to right direction

skinparam backgroundColor #080D14
skinparam shadowing false
skinparam roundcorner 20

skinparam actor {
    BackgroundColor #111A25
    BorderColor #3B82F6
    FontColor #FFFFFF
}

skinparam usecase {
    BackgroundColor #111A25
    BorderColor #3B82F6
    FontColor #FFFFFF
    ArrowColor #60A5FA
}

skinparam rectangle {
    BackgroundColor #0D141D
    BorderColor #263445
    FontColor #FFFFFF
}

skinparam ArrowColor #60A5FA
skinparam ArrowThickness 1.5

title <color:#FFFFFF><size:20><b>GAME LIST</b></size></color>\n<color:#94A3B8>Diagrama de Casos de Uso — Entrega 02</color>

actor "Usuário" as Usuario

rectangle "GameList" {
    usecase "Acessar boas-vindas" as UC01
    usecase "Cadastrar-se" as UC02
    usecase "Realizar login" as UC03
    usecase "Visualizar início" as UC04
    usecase "Adicionar jogo" as UC05
    usecase "Visualizar detalhes\ndo jogo" as UC06
    usecase "Editar jogo" as UC07
    usecase "Visualizar biblioteca" as UC08
    usecase "Descobrir jogos" as UC09
    usecase "Visualizar perfil" as UC10
    usecase "Visualizar configurações" as UC11
}

Usuario --> UC01
Usuario --> UC02
Usuario --> UC03
Usuario --> UC04
Usuario --> UC05
Usuario --> UC06
Usuario --> UC07
Usuario --> UC08
Usuario --> UC09
Usuario --> UC10
Usuario --> UC11

UC01 -[hidden]right- UC05
UC05 -[hidden]right- UC09
UC02 -[hidden]right- UC06
UC06 -[hidden]right- UC10
UC03 -[hidden]right- UC07
UC07 -[hidden]right- UC11
UC04 -[hidden]right- UC08

UC01 -[hidden]down- UC02
UC02 -[hidden]down- UC03
UC03 -[hidden]down- UC04

legend bottom
    <color:#FFFFFF><b>GameList</b></color>
    <color:#94A3B8>Programação para Dispositivos Móveis</color>
endlegend

@enduml
